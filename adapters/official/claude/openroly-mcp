#!/bin/sh
# Entry point for the openroly MCP server. The plugin's `.mcp.json` points `command` here.
#
# Static JSON can't choose "the binary if present, otherwise bun", so this one script sits in between.
# The order matches resolveMcpServerCommand in `packages/adapter/src/mcp-config.ts`:
#
#   1. $OPENROLY_MCP_BINARY   (explicit override)
#   2. $OPENROLY_HOME/bin/openroly-mcp  (default ~/.openroly/bin/openroly-mcp, where downloads go)
#      **only if its version matches** — an older version is re-fetched in step 2.5
#   3. bun "$@"          (= the bundle listed in .mcp.json's args; the original path)
#   4. if none of these exist, fetch the binary from the public Release and use step 2
#
# The binary path does not receive `$@` (the bundle path): the bundle is input for bun, and the
# compiled binary has its own entry point built in. The environment is inherited as-is (exec).
#
# **Never write to stdout** (MCP speaks JSON-RPC over stdio; a single stray byte breaks the handshake).
# Only when nothing is found, print what to install on stderr and exit 1 —
# failing silently would look to the runtime like "the tool doesn't exist".
set -u

if [ -n "${OPENROLY_MCP_BINARY:-}" ] && [ -x "$OPENROLY_MCP_BINARY" ]; then
  # if exec fails, fail here (don't fall back to bun and hide a broken binary)
  exec "$OPENROLY_MCP_BINARY"
fi

openroly_bin="${OPENROLY_HOME:-${HOME:-}/.openroly}/bin/openroly-mcp"
# The version the plugin expects. Keep it **equal** to OPENROLY_BINARY_VERSION in
# `packages/adapter/src/binary.ts` (apps/cli/test/login-binary.test.ts checks that they match)
ver="${OPENROLY_BINARY_VERSION:-0.2.3}"

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d" " -f1
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -d" " -f1
  fi
}

# Fetch the binary from the public Release. Same shape as ensureBinary() on the TypeScript side:
# checksum required, tmp → rename, public Release only (no token needed).
fetch_binary() {
  command -v curl >/dev/null 2>&1 || return 1
  case "$(uname -s)/$(uname -m)" in
    Darwin/arm64) target=darwin-arm64 ;;
    Darwin/x86_64) target=darwin-x64 ;;
    Linux/x86_64) target=linux-x64 ;;
    *) return 1 ;;  # unsupported OS/arch
  esac
  base="${OPENROLY_BINARY_BASE_URL:-https://github.com/openroly/openroly/releases/download}"
  dir=$(dirname "$openroly_bin")
  mkdir -p "$dir" 2>/dev/null || return 1

  # Fetch the checksum list first (no point downloading 66MB to find there's no list)
  want=$(curl -fsSL --max-time 60 "$base/v$ver/SHA256SUMS" 2>/dev/null | grep " openroly-mcp-$target$" | cut -d" " -f1)
  [ -n "$want" ] || return 1

  tmp="$dir/.openroly-mcp.$$.tmp"
  curl -fsSL --max-time 600 -o "$tmp" "$base/v$ver/openroly-mcp-$target" 2>/dev/null || { rm -f "$tmp"; return 1; }
  [ "$(sha256_of "$tmp")" = "$want" ] || { rm -f "$tmp"; return 1; }
  chmod 755 "$tmp" 2>/dev/null && mv "$tmp" "$openroly_bin" || { rm -f "$tmp"; return 1; }
  printf "%s\n" "$ver" > "$openroly_bin.version" 2>/dev/null
  return 0
}

# The version marker `<binary>.version` is one line that ensureBinary / fetch_binary write **after**
# placing the binary. **Present but different = a previous version's binary is still there**, so
# re-fetch. Without this check, a machine whose plugin was updated keeps exec'ing the old binary, and
# the runtime only sees "that tool doesn't exist" (broken in a way nobody can trace).
# **No marker = don't re-fetch** — the message below tells people they can place the binary by hand,
# and that path shouldn't be thrown away just because the version can't be read.
stale=0
if [ -x "$openroly_bin" ] && [ -f "$openroly_bin.version" ]; then
  installed=$(tr -d " \t\r\n" < "$openroly_bin.version" 2>/dev/null)
  [ "$installed" = "$ver" ] || stale=1
fi

if [ -x "$openroly_bin" ] && [ "$stale" -eq 0 ]; then
  exec "$openroly_bin"
fi

# Out of date: **re-fetch, then** start. Only exec if the fetch worked — otherwise fall back to bun,
# and if there's no bun either, start the old binary at the end (never just do nothing)
fetched=0
if [ "$stale" -eq 1 ]; then
  fetched=1
  if fetch_binary && [ -x "$openroly_bin" ]; then
    exec "$openroly_bin"
  fi
  echo "openroly: the installed MCP binary is not v$ver and could not be refreshed; falling back." >&2
fi

if command -v bun >/dev/null 2>&1; then
  exec bun "$@"
fi

# Last resort: fetch the binary from the public Release.
# Getting here means no binary and no bun, so **it cannot start as things are**; a slow fetch beats
# doing nothing (the next start hits step 1). Don't retry if it was already tried above.
if [ "$fetched" -eq 0 ] && fetch_binary && [ -x "$openroly_bin" ]; then
  exec "$openroly_bin"
fi

# An old binary that couldn't be refreshed is still used at this point — being out of date is far
# better than not starting (only machines with no network and no bun reach this branch)
if [ -x "$openroly_bin" ]; then
  exec "$openroly_bin"
fi

# Use only `echo` (a builtin) — this branch is hit most on machines with a minimal PATH, so
# printing the help must not require an external command (cat etc.)
{
  echo "openroly: cannot start the MCP server (neither the binary nor bun was found)."
  echo "  Either one fixes it:"
  echo "    1) place the openroly binary at: ~/.openroly/bin/openroly-mcp"
  echo "       (or point OPENROLY_MCP_BINARY at an absolute path)"
  echo "    2) install bun:              curl -fsSL https://bun.sh/install | bash"
  echo "  (fetching it from the public Release was also tried and did not succeed —"
  echo "   check the network, curl, and that the OS is supported: darwin-arm64, darwin-x64, linux-x64)"
} >&2
exit 1
