#!/bin/sh
# paa MCP server の起動口(PBI-0132)。plugin の `.mcp.json` はここを `command` に指す。
#
# 静的 JSON では「binary が在れば binary、無ければ bun」を分岐できないので、1 枚だけ挟む。
# 順序は `packages/adapter/src/mcp-config.ts` の resolveMcpServerCommand と同じ:
#
#   1. $PAA_MCP_BINARY   (明示指定)
#   2. $PAA_HOME/bin/atn-mcp  (既定 ~/.atn/bin/atn-mcp。PBI-0137 の download 先)
#   3. bun "$@"          (= .mcp.json の args に入っている bundle。従来経路)
#   4. どれも無ければ公開 Release から binary を取ってきて 2 段目に落とす(PBI-0137)
#
# binary 経路では `$@`(bundle path)を渡さない —— bundle は bun 用の材料で、compile 済み
# binary は自分の entry を内蔵しているため。env はそのまま継承される(exec なので透過)。
#
# **stdout に何も書かない**(MCP は stdio で JSON-RPC を流す面。1 byte でも混ぜたら handshake が壊れる)。
# 何も見つからない時だけ stderr に「何を入れれば動くか」を出して exit 1 ——
# 黙って無反応にすると runtime 側は「tool が無い」としか見えない。
set -u

if [ -n "${PAA_MCP_BINARY:-}" ] && [ -x "$PAA_MCP_BINARY" ]; then
  # exec が失敗したらそのまま落とす(握り潰して bun に落ちない = 壊れた binary を隠さない)
  exec "$PAA_MCP_BINARY"
fi

paa_bin="${PAA_HOME:-${HOME:-}/.atn}/bin/atn-mcp"
if [ -x "$paa_bin" ]; then
  exec "$paa_bin"
fi

if command -v bun >/dev/null 2>&1; then
  exec bun "$@"
fi

# 最後の手段: 公開 Release から binary を取ってくる(PBI-0137)。
# ここに来た = binary も bun も無い = **このままでは絶対に起動できない**ので、遅くても取りに行く
# 方が無反応で終わるより良い(2 回目からは 1 段目で当たる)。取得の形は TypeScript 側の
# ensureBinary() と同じ: checksum 必須・tmp → rename・公開 Release のみ(token を要求しない)。
sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d" " -f1
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -d" " -f1
  fi
}

fetch_binary() {
  command -v curl >/dev/null 2>&1 || return 1
  case "$(uname -s)/$(uname -m)" in
    Darwin/arm64) target=darwin-arm64 ;;
    Darwin/x86_64) target=darwin-x64 ;;
    Linux/x86_64) target=linux-x64 ;;
    *) return 1 ;;  # 未対応 OS/arch
  esac
  base="${PAA_BINARY_BASE_URL:-https://github.com/personal-agent-account/all-together-now/releases/download}"
  ver="${PAA_BINARY_VERSION:-0.2.3}"
  dir=$(dirname "$paa_bin")
  mkdir -p "$dir" 2>/dev/null || return 1

  # 照合表を先に取る(66MB を引いてから「表が無い」と分かるのは無駄)
  want=$(curl -fsSL --max-time 60 "$base/v$ver/SHA256SUMS" 2>/dev/null | grep " atn-mcp-$target$" | cut -d" " -f1)
  [ -n "$want" ] || return 1

  tmp="$dir/.atn-mcp.$$.tmp"
  curl -fsSL --max-time 600 -o "$tmp" "$base/v$ver/atn-mcp-$target" 2>/dev/null || { rm -f "$tmp"; return 1; }
  [ "$(sha256_of "$tmp")" = "$want" ] || { rm -f "$tmp"; return 1; }
  chmod 755 "$tmp" 2>/dev/null && mv "$tmp" "$paa_bin" || { rm -f "$tmp"; return 1; }
  printf "%s\n" "$ver" > "$paa_bin.version" 2>/dev/null
  return 0
}

if fetch_binary && [ -x "$paa_bin" ]; then
  exec "$paa_bin"
fi

# `echo` だけで書く(builtin) —— ここは PATH が痩せている環境ほど踏む枝なので、
# 案内を出すために外部 command(cat 等)を要求しない
{
  echo "atn: cannot start the MCP server (neither the binary nor bun was found)."
  echo "  Either one fixes it:"
  echo "    1) place the atn binary at: ~/.atn/bin/atn-mcp"
  echo "       (or point PAA_MCP_BINARY at an absolute path)"
  echo "    2) install bun:              curl -fsSL https://bun.sh/install | bash"
  echo "  (fetching it from the public Release was also tried and did not succeed —"
  echo "   check the network, curl, and that the OS is supported: darwin-arm64, darwin-x64, linux-x64)"
} >&2
exit 1
