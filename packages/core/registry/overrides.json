        },
        "apps": [],
        "services": []
      },
      "version": {
        "args": [
          "--version"
        ]
      },
      "launch": {
        "new": [],
        "existing": [
          "--continue"
        ],
        "headless": {
          "argv": [
            "-p",
            "${instruction}",
            "--tools",
            "",
            "--setting-sources",
            "project",
            "${mcp_argv}",
            "--permission-mode",
            "dontAsk",
            "--allowedTools",
            "mcp__openroly",
            "--output-format",
            "json",
            "--max-turns",
            "${max_turns}"
          ]
        },
        "mcp_inject": {
          "strategy": "config_flag",
          "file": "openroly-mcp.json",
          "argv": [
            "--strict-mcp-config",
            "--mcp-config",
            "${mcp_file}"
          ]
        }
      },
      "note": "dedicated wake の起こし方（PBI-0618 で broker の match arm から降ろした。実測 C = PBI-0019 / 実測 E = PBI-0167, 2026-09-02 Claude Code 2.1.258）。`--allowedTools mcp__openroly` **だけでは Bash が通る** —— `--permission-mode dontAsk` は「聞かずに実行する」であって allow list ではなく、user の settings.json に allow:[\"Bash\"] が有ろうと無かろうと Bash は動いた。組込み tool を落とすのは `--tools \"\"`（組込みを 1 つも積まない。MCP tool は別枠なので openroly は残る）。`--setting-sources project` は user / local の settings.json（allow 規則と hooks）を読ませないためだが、MCP の登録もそこに在るので openroly の定義は session_dir に複製して渡す（launch.mcp_inject = config_flag）。`--tools` / `--mcp-config` / `--allowedTools` は可変長引数なので **直後には必ず別の flag を置く** —— positional が続くと flag が食う（`--mcp-config <path> mcp list` が \"MCP config file not found: .../mcp\" に化けた）。catalog-build がこの並びを検証する。`${mcp_argv}` は launch.mcp_inject が組んだ引数の差し込み位置、`${max_turns}` は broker の定数（コスト上限。実測 C: 3 turn で $0.31〜0.39）—— 1 session の turn 上限を、catalog の署名し直し無しに動かせる所へ残す。",
      "capabilities": [
        "coding",
        "shell",
        "files"
      ],
      "adapter": "official/claude",
      "egress": {
        "hosts": [
          "api.anthropic.com"
        ]
      },
      "sources": [
        "https://code.claude.com/docs/en/skills"
      ],
      "verified": "cli:2.0"
    },
