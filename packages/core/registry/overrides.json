    {
      "id": "openclaw",
      "display_name": "OpenClaw",
      "kind": "cli",
      "aliases": [
        "openclaw"
      ],
      "detect": {
        "binaries": [
          "openclaw",
          "moltbot",
          "clawdbot"
        ],
        "apps": [],
        "services": []
      },
      "version": {
        "args": [
          "--version"
        ]
      },
      "capabilities": [
        "coding",
        "shell",
        "files"
      ],
      "adapter": "generic/native",
      "native": {
        "home": {
          "default": "~/.openclaw"
        },
        "bin": "openclaw",
        "version_args": [
          "--version"
        ],
        "install": "npm i -g openclaw",
        "mcp": {
          "strategy": "cli",
          "bin": "openclaw",
          "add": [
            "mcp",
            "add",
            "${name}",
            "--command",
            "${command}",
            "--arg...",
            "${args}",
            "--env...",
            "${env}",
            "--no-probe"
          ],
          "remove": [
            "mcp",
            "unset",
            "${name}"
          ],
          "read": {
            "path": "~/.openclaw/openclaw.json",
            "format": "json5",
            "key": "mcp.servers",
            "shape": "map"
          }
        },
        "skills": {
          "dir": "~/.agents/skills"
        },
        "instructions": {
          "file": "~/.openclaw/workspace/AGENTS.md"
        }
      },
      "sources": [
        "https://github.com/openclaw/openclaw",
        "https://docs.openclaw.ai/tools/skills"
      ],
      "verified": "cli:2026.7.1-2"
    },
