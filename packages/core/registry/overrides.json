            "remove",
            "--name",
            "${name}",
            "--scope",
            "global"
          ],
          "read": {
            "path": "~/.kiro/settings/mcp.json",
            "format": "json",
            "key": "mcpServers",
            "shape": "map"
          }
        },
        "instructions": {
          "dir": "~/.kiro/steering",
          "filename": "openroly-${name}.md"
        }
      },
      "egress": {
        "hosts": [
          "*.kiro.dev",
          "*.amazonaws.com"
        ]
      },
      "sandbox_verified": "2026-09-04 kiro 2.21.1",
      "sources": [
        "https://github.com/kirodotdev/Kiro",
        "https://kiro.dev/docs/skills/"
