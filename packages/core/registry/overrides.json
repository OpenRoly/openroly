        "new": [],
        "existing": [
          "--continue"
        ],
        "headless": {
          "argv": [
            "run",
            "${instruction}"
          ]
        }
      },
      "capabilities": [
        "coding",
        "shell",
        "files"
      ],
      "adapter": "generic/native",
      "native": {
        "home": {
          "default": "~/.config/opencode"
        },
        "bin": "opencode",
        "version_args": [
          "--version"
        ],
        "install": "curl -fsSL https://opencode.ai/install | bash",
        "mcp": {
          "strategy": "file",
          "path": "~/.config/opencode/opencode.json",
          "format": "jsonc",
          "key": "mcp",
          "shape": "map",
          "entry": {
            "type": "local",
            "command": [
              "${command}",
              "${args...}"
            ],
            "environment": "${env}",
            "enabled": true
          }
        },
        "instructions": {
          "file": "~/.config/opencode/AGENTS.md"
        }
      },
      "egress": {
        "hosts": [
          "models.opencode.ai"
        ]
      },
      "sandbox_verified": "2026-09-04 opencode 1.18.10",
      "sources": [
        "https://github.com/sst/opencode",
        "https://opencode.ai/docs/skills/"
      ],
      "verified": "cli:1.18.10"
    },
