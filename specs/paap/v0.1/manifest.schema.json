{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paap:v0.1:manifest",
  "title": "PAAP v0.1 Manifest",
  "description": "The table of contents of a capsule directory: every other file with its sha256, and what a person must re-enter after import (I-11).",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "exported_at", "exporter", "contents", "reenter"],
  "properties": {
    "protocol": { "type": "string", "const": "paap/0.1" },
    "exported_at": { "$ref": "#/$defs/timestamp" },
    "exporter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "version": { "$ref": "#/$defs/text" }
      }
    },
    "contents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/text" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "reenter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential_refs", "devices"],
      "properties": {
        "credential_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
        },
        "devices": { "type": "integer", "minimum": 0 }
      }
    },
    "ext": { "$ref": "#/$defs/ext" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "timestamp": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
    },
    "ext": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[a-z0-9-]+\\.[A-Za-z0-9_.-]+$" }
    }
  }
}
